{
  "manifest_version": 3,
  "name": "Scribe音声入力",
  "version": "0.1.0",
  "description": "ElevenLabs Scribe で音声入力し、漢数字を算用数字に直してカーソル位置に入力する",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "offscreen", "storage", "clipboardWrite"],
  "host_permissions": ["https://api.elevenlabs.io/*", "https://api.anthropic.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Scribe音声入力" },
  "options_page": "options.html",
  "commands": {
    "toggle-recording": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "録音の開始／停止"
    }
  }
}
